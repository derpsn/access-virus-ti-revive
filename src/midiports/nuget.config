<?xml version="1.0" encoding="utf-8"?>
<!-- Windows.Devices.Midi2 is not on nuget.org: the package from github.com/microsoft/MIDI releases goes into
     ./packages (downloaded by the build, not committed) -->
<configuration>
  <packageSources>
    <add key="local-midi2" value="./packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
