<?xml version="1.0" encoding="utf-8"?>
<!--
  TIRevive.wxs - MSI for "TI Revive" (milestone M6, findings/design.md). Build: src/installer/build.ps1 (WiX 5) or .github/workflows/build.yml.
  Per-machine install of our files only; the files of the user's Access MSI that the plug-in reads are unpacked
  afterwards by tirevive-access.ps1 (exit dialog checkbox / Start menu) - the Access software is not installed.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="TI Revive" Manufacturer="TI Revive" Version="$(var.Version)" UpgradeCode="248B1670-6464-4F0A-965F-9CA56380C1AD"
           Scope="perMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="TI Revive - Total Integration for Access Virus TI on Windows 11" />
    <!-- the same version replaces too (release candidates, rebuilds), never two entries side by side -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of TI Revive is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPCOMMENTS" Value="Total Integration for Access Virus TI on Windows 11 (WinUSB bridge)" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="TI Revive" />
    </StandardDirectory>
    <StandardDirectory Id="CommonFiles64Folder">
      <Directory Id="VST3FOLDER" Name="VST3" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="MENUFOLDER" Name="TI Revive" />
    </StandardDirectory>

    <ComponentGroup Id="Core" Directory="INSTALLFOLDER">
      <Component>
        <File Id="vtibroker" Source="$(var.Bin)\vtibroker.exe" KeyPath="yes" />
        <!-- the broker owns the device for the logged-on user; NOT started at logon: the plug-in / Control Center
             start it on demand (found via InstallDir) and it exits when no client has been connected for 30 s -->
        <RegistryValue Root="HKLM" Key="Software\TI Revive" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" />
      </Component>
      <!-- 0.8.0: the classic plug-in "Virus TI (TI Revive)" (wrapper of the Access plug-in), its ASIO wrapper and the
           Control Center launcher are gone - "TI Revive Virus Control" (native.wxs) replaces them; an upgrade
           removes their files because they are no longer part of the package -->
      <Component><File Source="$(var.Src)\inf\vti_winusb.inf" /></Component>
      <Component><File Id="driverps1" Source="$(var.Src)\installer\tirevive-driver.ps1" /></Component>
      <Component><File Id="accessps1" Source="$(var.Src)\installer\tirevive-access.ps1" /></Component>
      <Component><File Id="shortcutsps1" Source="$(var.Src)\installer\tirevive-shortcuts.ps1" /></Component>
      <Component><File Id="bundlesps1" Source="$(var.Src)\installer\tirevive-bundles.ps1" /></Component>
      <Component><File Source="$(var.Src)\installer\notice.rtf" /></Component>
      <Component><File Id="licensetxt" Source="$(var.Src)\..\LICENSE" Name="LICENSE.txt" /></Component>
      <Component><File Source="$(var.Src)\..\THIRD-PARTY-NOTICES.txt" /></Component>
    </ComponentGroup>
    <ComponentGroup Id="Menu" Directory="MENUFOLDER">
      <Component Id="MenuShortcuts" Guid="7C1D3F2E-1B5A-4C8E-9A2D-3E4F5A6B7C8D">
        <Shortcut Id="accessShortcut" Name="Set up Access Virus TI files" Target="[System64Folder]WindowsPowerShell\v1.0\powershell.exe"
                  Arguments="-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File &quot;[INSTALLFOLDER]tirevive-access.ps1&quot;"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveMenuFolder" On="uninstall" />
        <RegistryValue Root="HKLM" Key="Software\TI Revive\Installer" Name="MenuShortcuts" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="TI Revive" Level="1">
      <ComponentGroupRef Id="Core" />
      <ComponentGroupRef Id="Menu" />
<?if $(var.Native) = "1" ?>
      <!-- the native plug-in "TI Revive Virus Control" + ASIO driver "TI Revive Virus Audio" (native/packaging/windows/native.wxs) -->
      <ComponentGroupRef Id="Native" />
<?endif?>
    </Feature>

    <!-- driver package + trusted cert (deferred, SYSTEM), and the reverse on uninstall -->
    <SetProperty Id="CA_DriverInstall" Sequence="execute" Before="CA_DriverInstall"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]tirevive-driver.ps1&quot; install" />
    <!-- stop a running broker (0.3.0 and older started it at logon) before Windows checks files in use -->
    <SetProperty Id="WixQuietExec64CmdLine" Value="&quot;[System64Folder]taskkill.exe&quot; /F /IM vtibroker.exe"
                 Before="CA_StopBroker" Sequence="execute" />
    <CustomAction Id="CA_StopBroker" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64" Execute="immediate" Return="ignore" />
    <CustomAction Id="CA_DriverInstall" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64" Execute="deferred" Impersonate="no" Return="check" />
    <SetProperty Id="CA_DriverUninstall" Sequence="execute" Before="CA_DriverUninstall"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]tirevive-driver.ps1&quot; uninstall" />
    <CustomAction Id="CA_DriverUninstall" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64" Execute="deferred" Impersonate="no" Return="ignore" />
    <!-- an .msi run directly (no setup.exe) removes the uninstall entries of earlier setup.exe installs whose MSI it
         replaces (E186); two actions: the script exists only after InstallFiles (install) and before RemoveFiles (uninstall) -->
    <SetProperty Id="CA_StaleBundles" Sequence="execute" Before="CA_StaleBundles"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]tirevive-bundles.ps1&quot; -Run" />
    <CustomAction Id="CA_StaleBundles" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64" Execute="deferred" Impersonate="no" Return="ignore" />
    <SetProperty Id="CA_StaleBundlesUninstall" Sequence="execute" Before="CA_StaleBundlesUninstall"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]tirevive-bundles.ps1&quot; -Run" />
    <CustomAction Id="CA_StaleBundlesUninstall" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64" Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="CA_StopBroker" Before="InstallValidate" />
      <Custom Action="CA_DriverInstall" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="CA_DriverUninstall" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="CA_StaleBundles" After="InstallFiles" Condition="NOT REMOVE AND NOT TIREVIVE_BUNDLE" />
      <Custom Action="CA_StaleBundlesUninstall" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND NOT TIREVIVE_BUNDLE" />
    </InstallExecuteSequence>

    <!-- exit dialog: install the user's Access software now (as the user; msiexec elevates itself) -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Set up the Access Virus TI files now (recommended)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <!-- 0.8.32 and older could set up the 32-bit Virus Control.dll, which the plug-in no longer reads (E345); the
         set-up below replaces it, but only with the Access .msi at hand -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Updating from 0.8.32 or older? Keep the box below checked and the Access 64-bit .msi next to this installer or in Downloads: older setups could copy the 32-bit Virus Control.dll, which TI Revive no longer reads." />
    <CustomAction Id="CA_LaunchAccess" Directory="INSTALLFOLDER" Return="asyncNoWait" Impersonate="yes"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File &quot;[INSTALLFOLDER]tirevive-access.ps1&quot; -FromMsi &quot;[OriginalDatabase]&quot; -SourceDir &quot;[TIREVIVE_SOURCEDIR]&quot;" />
    <!-- set by TI-Revive-setup.exe (TIReviveSetup.wxs): the folder of the setup.exe, where the Access .msi usually is -->
    <Property Id="TIREVIVE_SOURCEDIR" Secure="yes" />
    <!-- set by TI-Revive-setup.exe on every action: Burn handles its own and older bundles' entries (CA_StaleBundles) -->
    <Property Id="TIREVIVE_BUNDLE" Secure="yes" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.Src)\installer\notice.rtf" />
    <!-- own artwork (src/installer/art/make_art.py), no Access/Kemper material -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.Src)\installer\art\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.Src)\installer\art\dialog.bmp" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="CA_LaunchAccess"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
  </Package>
</Wix>
