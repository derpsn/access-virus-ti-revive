{
 "about": "Risk class per changed file (scripts/risk.py; findings/testing.md). First matching rule wins; a file no rule names counts as class C on every platform. A = logic covered by unit tests, docs, tools that are not shipped: no manual items. B = I/O, timing, threads, the send path: the core items named here (on Linux run by scripts/hil.sh where automated). C = platform code, installers, drivers, sleep/wake, rule-2 guards: the named core items on that platform by hand. Patterns use fnmatch (* also crosses /).",
 "platforms": {"linux": "linux", "windows": "vm", "mac": "mac"},
 "core_keys": ["cold", "reopen", "export", "power", "sleep"],
 "automated": {"linux": ["cold", "reopen", "export", "sleep"], "windows": ["cold", "reopen", "export"],
               "mac": ["cold", "reopen", "export"]},
 "rotation": {"why": "no finding in rounds 0.8.23-0.8.27 (findings/testing.md, yield table): by hand for class B only every 3rd round",
              "keys": ["reopen", "power"], "every": 3},
 "rules": [
  {"why": "docs, findings, site, project files",
   "paths": ["*.md", "LICENSE", "CITATION.cff", "THIRD-PARTY-NOTICES.txt", ".gitignore", ".gitmodules", "*/.gitignore",
             "findings/*", "docs/*", "native/docs/*", "site/*", "scripts/site/*", ".claude/*", ".github/ISSUE_TEMPLATE/*",
             ".github/FUNDING.yml", ".github/PULL_REQUEST_TEMPLATE.md", ".github/workflows/site.yml",
             ".github/workflows/cache.yml"],
   "class": "A"},
  {"why": "tests and test/research tools: not shipped",
   "paths": ["native/tests/*", "native/tools/*", "scripts/tests/*", "scripts/checklists/*", "scripts/*.py",
             "scripts/capture.sh", "scripts/ts.sh", "scripts/mac.sh", "scripts/mac-recon.sh", "scripts/mac-install-poc.sh",
             "scripts/vm.sh", "scripts/vm-start-cc.cmd", "scripts/vm-winusb-install.ps1", "scripts/win11/*", "scripts/win10ref/*",
             "scripts/virus.xml", "scripts/linux-usb-bounce.sh", "scripts/giveback-loop.sh", "scripts/hil.sh", "scripts/hil-win.ps1", "scripts/hil-win.cmd",
             "scripts/hil-mac.command", "scripts/mutation.sh",
             ".github/workflows/dev-mac.yml"],
   "class": "A"},
  {"why": "0.7.x and research code: not shipped since 0.8.0",
   "paths": ["src/wrapper/*", "src/vtihook/*", "src/mac/*", "src/broker/vtiflash.c", "src/broker/vtisend.c",
             "src/broker/vtiprobe.c", "src/broker/vtiaudiotest*.c"],
   "class": "A"},
  {"why": "pure logic with unit tests: model, Access files, editor model, Control Center decoding",
   "paths": ["native/src/model/*", "native/src/access/*", "native/src/editor/*", "native/src/cc/decode.*",
             "native/src/cc/ccskin.*", "native/src/cc/diag.*"],
   "class": "A"},

  {"why": "rule 2 (never send what can hurt the Virus): every platform, by hand too",
   "paths": ["native/src/device/sendguard.h", "native/src/device/automation.h", "native/src/device/sendbudget.h",
             "src/broker/ctrlguard.h", "src/broker/resetguard.h", "src/broker/flashinfo.h"],
   "class": "C", "platforms": ["linux", "windows", "mac"], "core": ["cold", "export"]},
  {"why": "macOS only: audio ring and sleep (E207, E208)",
   "paths": ["native/src/device/gapfill.h", "native/src/device/stallwatch.h"],
   "class": "C", "platforms": ["mac"], "core": ["cold", "export", "sleep"]},
  {"why": "the Virus going away and coming back, sleep (E212)",
   "paths": ["native/src/device/presencewatch.h", "native/src/device/keepalive.h"],
   "class": "C", "platforms": ["linux", "windows", "mac"], "core": ["cold", "power", "sleep"]},
  {"why": "the send path, timing, audio: same code on every platform, behaviour depends on the device",
   "paths": ["native/src/device/*"],
   "class": "B", "platforms": ["linux", "windows", "mac"], "core": ["cold", "export"]},
  {"why": "the plug-in's processor (audio thread, start-up, state)",
   "paths": ["native/plugin/source/virusplugin.*", "native/plugin/source/entry.cpp"],
   "class": "B", "platforms": ["linux", "windows", "mac"], "core": ["cold", "reopen", "export"]},
  {"why": "the editor window: platform popups",
   "paths": ["native/plugin/source/popupwindow_x11.cpp"], "class": "C", "platforms": ["linux"], "core": ["cold"]},
  {"why": "the editor window: platform popups",
   "paths": ["native/plugin/source/popupwindow_win.cpp"], "class": "C", "platforms": ["windows"], "core": ["cold"]},
  {"why": "the editor window: platform popups",
   "paths": ["native/plugin/source/popupwindow_mac.mm"], "class": "C", "platforms": ["mac"], "core": ["cold"]},
  {"why": "the editor (GUI on every platform; menus and pages are checked on Linux)",
   "paths": ["native/plugin/source/viruseditor.*", "native/plugin/source/popupwindow.h"],
   "class": "B", "platforms": ["linux"], "core": ["cold"]},
  {"why": "Control Center app",
   "paths": ["native/src/cc/*", "native/ccapp/*"], "class": "B", "platforms": ["linux", "windows", "mac"], "core": []},

  {"why": "broker: platform USB layers (Windows: WinUSB device access and audio streaming)",
   "paths": ["src/broker/vticore_winusb.c", "src/broker/vticore_pipe.c", "src/broker/vtibroker.c", "src/broker/vtipipe_io.h",
             "src/broker/vtiusbaudio.c", "src/broker/vtiusbaudio.h"],
   "class": "C", "platforms": ["windows"], "core": ["cold", "reopen", "power", "sleep"]},
  {"why": "broker: platform USB layers",
   "paths": ["src/broker/vtimidi_mac.*"], "class": "C", "platforms": ["mac"], "core": ["cold", "reopen", "power", "sleep"]},
  {"why": "broker: libusb audio and the POSIX broker (Linux and macOS)",
   "paths": ["src/broker/vtiusbaudio_libusb.*", "src/broker/vtibroker_posix.c", "src/broker/vticore_sock.c"],
   "class": "C", "platforms": ["linux", "mac"], "core": ["cold", "reopen", "power", "sleep"]},
  {"why": "broker: shared core, protocol, pacing",
   "paths": ["src/broker/*"], "class": "B", "platforms": ["linux", "windows", "mac"], "core": ["cold", "reopen", "export"]},

  {"why": "Windows: ASIO driver, driver package, installer",
   "paths": ["native/asio/*", "src/inf/*", "src/installer/*", "native/packaging/windows/*"],
   "class": "C", "platforms": ["windows"], "core": ["cold", "reopen", "export"]},
  {"why": "macOS: Audio Unit, installer",
   "paths": ["native/au/*", "src/installer-mac/*", "scripts/mac-build-release.sh", "scripts/mac-build-bridge.sh",
             "scripts/mac-install-broker.sh"],
   "class": "C", "platforms": ["mac"], "core": ["cold", "reopen", "export"]},
  {"why": "Linux: installer, udev rule, socket activation",
   "paths": ["src/installer-linux/*", "scripts/linux-build-release.sh", "scripts/99-virus-ti.rules"],
   "class": "C", "platforms": ["linux"], "core": ["cold", "reopen"]},
  {"why": "Windows diagnostics script shipped with the release",
   "paths": ["scripts/tirevive-usbinfo.ps1"], "class": "B", "platforms": ["windows"], "core": []},
  {"why": "build files, release CI, the VST3 SDK and our patches to it: every package",
   "paths": ["native/external/*", "native/patches/*", "native/CMakeLists.txt", "native/plugin/CMakeLists.txt", ".github/workflows/build.yml",
             ".github/actions/*", ".github/apt/*"],
   "class": "C", "platforms": ["linux", "windows", "mac"], "core": ["cold"]}
 ]
}
